# ─────────────────────────────────────────────────────────────
# Royal Graphix — Environment Variables
#
# Copy this file to .env and fill in your real values.
# .env is gitignored and never committed to GitHub.
#
# VITE_ prefix is REQUIRED for Vite to expose variables to the
# browser bundle. Variables without VITE_ are server-only and
# will be undefined in the built app.
#
# CAPACITOR NOTE:
# Capacitor bundles the built dist/ folder into the APK.
# All environment variables are baked into the JS at build time
# (via import.meta.env). They are NOT read at runtime from a
# .env file inside the APK — the .env file is not bundled.
# This means:
#   - Set your real Supabase keys BEFORE running npm run build.
#   - npm run build → npx cap sync → the APK will have the keys.
#   - Never put secrets that should stay server-side here.
# ─────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
VITE_APP_NAME=Royal Graphix
VITE_APP_URL=https://royalgraphix.co.ke
